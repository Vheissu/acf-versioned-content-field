{
    "name": "vheissu/acf-versioned-content-field",
    "description": "Adds a versioned content field type to Advanced Custom Fields",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Dwayne Charrington",
            "homepage": "https://ilikekillnerds.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^2.36 || ^3.8 || ^4.0",
        "php-stubs/acf-pro-stubs": "^6.0",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.13",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AcfVersionedContentField\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AcfVersionedContentField\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "check": [
            "@phpcs",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
